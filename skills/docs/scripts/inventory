#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	DEPENDENCY CHECKS
##==================================================================================================
requireCommand() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'Missing dependency: %s\n' "$1" >&2
        exit 1
    }
}

requireCommand yq

##==================================================================================================
##	GLOBALS
##==================================================================================================
SCRIPT_DIRECTORY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
declare -r SCRIPT_DIRECTORY
declare -r FRONTMATTER_SCRIPT="$SCRIPT_DIRECTORY/get-frontmatter"
declare -a RECORDS=()

##==================================================================================================
##	UTILITIES
##==================================================================================================
die() {
    printf '%s\n' "$1" >&2
    exit 1
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================
extractMetadata() {
    local file="$1"
    local raw_frontmatter
    local metadata
    local title
    local description
    local status
    local updated
    local frontmatter_status

    if raw_frontmatter="$("$FRONTMATTER_SCRIPT" "$file" 2>/dev/null)"; then
        :
    else
        frontmatter_status=$?
        case "$frontmatter_status" in
            2)
                printf '0000-00-00\t%s\t(no frontmatter)\t\t\n' "$file"
                return
                ;;
            3) die "Unclosed YAML frontmatter: $file" ;;
            4) die "Invalid YAML frontmatter: $file" ;;
            *) die "Cannot read frontmatter: $file" ;;
        esac
    fi

    if ! metadata="$(printf '%s\n' "$raw_frontmatter" | yq -r '
        [
            (.title // .name // "(no title)" | tostring | sub("\\t"; " ") | sub("\\n"; " ") | sub("\\r"; " ") | sub("\\|"; " ") | trim),
            (.description // .summary // "" | tostring | sub("\\t"; " ") | sub("\\n"; " ") | sub("\\r"; " ") | sub("\\|"; " ") | trim),
            (.status // "" | tostring | sub("\\t"; " ") | sub("\\n"; " ") | sub("\\r"; " ") | sub("\\|"; " ") | trim),
            (.updated // .lastmod // .date // "0000-00-00" | tostring | sub("\\t"; " ") | sub("\\n"; " ") | sub("\\r"; " ") | sub("\\|"; " ") | trim)
        ] | join("|")
    ' 2>/dev/null)"; then
        die "Invalid YAML frontmatter: $file"
    fi

    IFS='|' read -r title description status updated <<< "$metadata"
    printf '%s\t%s\t%s\t%s\t%s\n' "$updated" "$file" "$title" "$status" "$description"
}

listRecords() {
    local directory="$1"
    local file

    while IFS= read -r -d '' file; do
        RECORDS+=("$(extractMetadata "$file")")
    done < <(find "$directory" -type f -name '*.md' -print0)
}

printRecords() {
    if (( ${#RECORDS[@]} == 0 )); then
        return
    fi

    printf '%s\n' "${RECORDS[@]}" |
        sort -t $'\t' -k1,1r -k2,2 |
        awk -F'\t' '
            {
                printf "%s\n", $2
                printf "  title:       %s\n", $3
                if ($1 != "0000-00-00") printf "  updated:     %s\n", $1
                if ($4 != "")           printf "  status:      %s\n", $4
                if ($5 != "")           printf "  description: %s\n", $5
                printf "\n"
            }
        '
}

##==================================================================================================
##	MAIN
##==================================================================================================
main() {
    local directory="${1:-.agent}"

    [[ -d "$directory" ]] || die "No directory: $directory"
    listRecords "$directory"
    printRecords
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================
main "$@"
