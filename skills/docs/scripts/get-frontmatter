#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	UTILITIES
##==================================================================================================
die() {
    local status="$1"
    shift
    printf '%s\n' "$1" >&2
    exit "$status"
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================
# Extract the raw YAML frontmatter block (between leading `---` fences) into a variable.
# Exit codes: 0 ok, 2 no opening `---` on line 1, 3 opened but never closed.
extractFrontmatter() {
    local file="$1"
    awk '
        NR == 1 {
            if ($0 != "---") exit 2
            opened = 1
            next
        }
        opened && $0 == "---" {
            closed = 1
            exit 0
        }
        opened { content = content $0 ORS }
        END {
            if (!opened) exit 2
            if (!closed) exit 3
            printf "%s", content
        }
    ' "$file"
}

printFrontmatter() {
    local file="$1"
    local content status

    if content="$(extractFrontmatter "$file")"; then
        status=0
    else
        status=$?
    fi

    case "$status" in
        0) ;;
        2) die 2 "Malformed frontmatter in $file: file must start with a '---' line. No frontmatter block found." ;;
        3) die 3 "Malformed frontmatter in $file: opening '---' has no matching closing '---'. Block is unclosed." ;;
        *) die 1 "Cannot read frontmatter in $file (unexpected extractor exit $status)." ;;
    esac

    # If yq is available, validate the block is parseable YAML so a malformed body
    # explains itself instead of printing silently-broken content.
    if command -v yq >/dev/null 2>&1; then
        local yq_error
        if ! yq_error="$(printf '%s' "$content" | yq -e '.' 2>&1 >/dev/null)"; then
            yq_error="${yq_error#Error: bad file *: }"
            die 4 "Malformed frontmatter in $file: block is not valid YAML. Parser said: ${yq_error:-unknown parse error}."
        fi
    fi

    printf '%s' "$content"
}

##==================================================================================================
##	MAIN
##==================================================================================================
main() {
    [[ $# == 1 ]] || die 1 'Usage: get-frontmatter <file.md>'
    [[ -f "$1" ]] || die 1 "No such file: $1"
    [[ -r "$1" ]] || die 1 "Unreadable file: $1"
    printFrontmatter "$1"
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================
main "$@"
