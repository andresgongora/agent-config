#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	DEPENDENCY CHECKS
##==================================================================================================
requireCommand() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'Missing dependency: %s\n' "$1" >&2
        exit 1
    }
}

requireCommand yq

##==================================================================================================
##	UTILITIES
##==================================================================================================
die() {
    printf '%s\n' "$1" >&2
    exit 1
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================
extractFrontmatter() {
    local file="$1"

    awk '
        NR == 1 {
            if ($0 != "---") exit 2
            opened = 1
            next
        }
        opened && $0 == "---" {
            closed = 1
            exit 0
        }
        opened { print }
        END {
            if (!opened) exit 2
            if (!closed) exit 3
        }
    ' "$file"
}

isNonEmptyScalar() {
    local key="$1"
    local frontmatter="$2"

    printf '%s' "$frontmatter" | KEY="$key" yq -e \
        'has(env(KEY)) and (.[env(KEY)] | type != "!!map" and type != "!!seq" and type != "!!null" and tostring | length > 0)' \
        >/dev/null 2>&1
}

checkRequiredStrings() {
    local frontmatter="$1"
    local key

    for key in title summary status updated; do
        isNonEmptyScalar "$key" "$frontmatter" || printf '%s: required non-empty value\n' "$key"
    done
}

checkStatus() {
    local frontmatter="$1"
    local status

    isNonEmptyScalar status "$frontmatter" || return
    status="$(printf '%s' "$frontmatter" | yq -r '.status')"
    case "$status" in
        draft|active|stale|resolved|archived|done) ;;
        *) printf 'status: must be draft, active, stale, resolved, archived, or done\n' ;;
    esac
}

checkUpdatedDate() {
    local frontmatter="$1"
    local updated

    isNonEmptyScalar updated "$frontmatter" || return
    updated="$(printf '%s' "$frontmatter" | yq -r '.updated')"
    [[ "$updated" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
        printf 'updated: must use YYYY-MM-DD\n'
}

checkOptionalSource() {
    local frontmatter="$1"

    if printf '%s' "$frontmatter" | yq -e 'has("source")' >/dev/null 2>&1; then
        printf '%s' "$frontmatter" | yq -e \
            'has("source") and (.source | type == "!!str" and length > 0)' >/dev/null 2>&1 ||
            printf 'source: must be a non-empty string\n'
    fi
}

checkFrontmatter() {
    local file="$1"
    local frontmatter
    local extraction_status
    local issues

    if frontmatter="$(extractFrontmatter "$file")"; then
        :
    else
        extraction_status=$?
        case "$extraction_status" in
            2) die 'frontmatter: file must start with ---' ;;
            3) die 'frontmatter: closing --- missing' ;;
            *) die 'frontmatter: cannot read file' ;;
        esac
    fi

    if ! printf '%s' "$frontmatter" | yq -e 'type == "!!map"' >/dev/null 2>&1; then
        die 'frontmatter: invalid YAML mapping'
    fi

    issues="$(checkRequiredStrings "$frontmatter"; checkStatus "$frontmatter"; \
        checkUpdatedDate "$frontmatter"; checkOptionalSource "$frontmatter")"
    [[ -z "$issues" ]] || die "$issues"
}

##==================================================================================================
##	MAIN
##==================================================================================================
main() {
    [[ $# == 1 ]] || die 'Usage: check-frontmatter <file.md>'
    [[ -f "$1" ]] || die "No such file: $1"
    [[ -r "$1" ]] || die "Unreadable file: $1"
    checkFrontmatter "$1"
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================
main "$@"
