#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	DEPENDENCY CHECKS

requireCommand() {
    local command_name=$1
    command -v "$command_name" >/dev/null 2>&1 || {
        printf 'Missing command: %s\n' "$command_name" >&2
        exit 2
    }
}

requireCommand find
requireCommand git
requireCommand realpath

##==================================================================================================
##	GLOBALS

REPORT_ONLY=false
VERIFY=false
DELETE_MERGED=false
BASE_BRANCH=""
ROOT_DIRECTORY="."
DIRECTORY_SET=false
REPOSITORIES=0
FAILURES=0
COMPACTED=0
VERIFIED=0
CANDIDATES=0
DELETED=0

##==================================================================================================
##	UTILITIES

die() {
    printf '%s\n' "$*" >&2
    exit 2
}

printUsage() {
    printf 'Usage: %s [--report] [--verify] [--delete-merged] [--base BRANCH] [directory]\n' "$0"
}

resolveRootDirectory() {
    local directory=$1
    local root_directory

    root_directory=$(realpath -e -- "$directory") || die "Cannot resolve directory: $directory"
    [[ -d $root_directory ]] || die "Not a directory: $root_directory"
    [[ $root_directory != / ]] || die 'Refusing unbounded directory'
    printf '%s\n' "$root_directory"
}

##==================================================================================================
##	CORE FUNCTIONS

verifyRepository() {
    local repository=$1

    git -C "$repository" fsck --connectivity-only --no-dangling
}

compactRepository() {
    local repository=$1

    git -C "$repository" repack -d -l
}

reportObjectSizes() {
    local repository=$1
    local object_sizes
    local key
    local value

    object_sizes=$(git -C "$repository" count-objects -v) || return 1
    while IFS=' ' read -r key value; do
        case $key in
            size:|size-pack:) printf 'OBJECTS\t%s\t%s KiB\n' "${key%:}" "$value" ;;
        esac
    done < <(printf '%s\n' "$object_sizes")
}

getCheckedOutBranches() {
    local repository=$1
    local worktree_data
    local field
    local value

    worktree_data=$(git -C "$repository" worktree list --porcelain) || return 1
    while IFS=' ' read -r field value; do
        [[ $field == branch ]] || continue
        printf '%s\n' "${value#refs/heads/}"
    done <<< "$worktree_data"
}

isBranchCheckedOut() {
    local branch=$1
    local checked_out_branches=$2
    local checked_out_branch

    while IFS= read -r checked_out_branch; do
        [[ $branch == "$checked_out_branch" ]] && return 0
    done <<< "$checked_out_branches"
    return 1
}

reportMergedBranches() {
    local repository=$1
    local base_branch=$2
    local delete_merged=$3
    local current_branch
    local branch
    local upstream
    local checked_out_branches
    local references
    local command_status

    if [[ -z $base_branch ]]; then
        printf 'MERGED\tskipped; use --base\n'
        return 0
    fi
    if git -C "$repository" show-ref --verify --quiet "refs/heads/$base_branch"; then
        :
    else
        command_status=$?
        if ((command_status == 1)); then
            printf 'MERGED\tskipped; missing base %q\n' "$base_branch"
            return 0
        fi
        return "$command_status"
    fi

    current_branch=$(git -C "$repository" branch --show-current) || return 1
    checked_out_branches=$(getCheckedOutBranches "$repository") || return 1
    references=$(git -C "$repository" for-each-ref \
        --format='%(refname:short)%09%(upstream:short)' refs/heads) || return 1

    while IFS=$'\t' read -r branch upstream; do
        [[ -n $branch && $branch != "$base_branch" && $branch != "$current_branch" && -n $upstream ]] || continue
        isBranchCheckedOut "$branch" "$checked_out_branches" && continue
        if git -C "$repository" show-ref --verify --quiet "refs/remotes/$upstream"; then
            :
        else
            command_status=$?
            ((command_status == 1)) && continue
            return "$command_status"
        fi
        if git -C "$repository" merge-base --is-ancestor "$branch" "$base_branch"; then
            :
        else
            command_status=$?
            ((command_status == 1)) && continue
            return "$command_status"
        fi
        ((CANDIDATES += 1))
        printf 'MERGED\tbranch=%q\tupstream=%q\tbase=%q\n' "$branch" "$upstream" "$base_branch"

        if [[ $delete_merged == true ]]; then
            if git -C "$repository" branch -d -- "$branch"; then
                ((DELETED += 1))
            else
                printf 'ERROR\tbranch deletion refused: %q\n' "$branch" >&2
                ((FAILURES += 1))
            fi
        fi
    done <<< "$references"
}

processRepository() {
    local repository=$1
    local report_only=$2
    local verify=$3
    local base_branch=$4
    local delete_merged=$5

    ((REPOSITORIES += 1))
    printf 'REPOSITORY\t%q\n' "$repository"

    if [[ $verify == true ]] && ! verifyRepository "$repository"; then
        printf 'ERROR\tconnectivity check failed\n' >&2
        ((FAILURES += 1))
        return 0
    fi
    [[ $verify == false ]] || ((VERIFIED += 1))

    if [[ $report_only == false ]] && ! compactRepository "$repository"; then
        printf 'ERROR\trepack failed\n' >&2
        ((FAILURES += 1))
        return 0
    fi
    [[ $report_only == true ]] || ((COMPACTED += 1))

    if ! reportObjectSizes "$repository"; then
        printf 'ERROR\tobject report failed\n' >&2
        ((FAILURES += 1))
        return 0
    fi

    if ! reportMergedBranches "$repository" "$base_branch" "$delete_merged"; then
        printf 'ERROR\tmerged-branch report failed\n' >&2
        ((FAILURES += 1))
    fi
}

processRepositoryTree() {
    local root_directory=$1
    local report_only=$2
    local verify=$3
    local base_branch=$4
    local delete_merged=$5
    local git_entry repository find_output_fd find_process_id

    coproc FIND_REPOSITORIES {
        find -P "$root_directory" \( -type d -name .git -prune -print0 \) -o \( -type f -name .git -print0 \)
    }
    exec {find_output_fd}<&"${FIND_REPOSITORIES[0]}"
    find_process_id=$FIND_REPOSITORIES_PID

    while IFS= read -r -d '' -u "$find_output_fd" git_entry; do
        repository=${git_entry%/.git}
        processRepository "$repository" "$report_only" "$verify" "$base_branch" "$delete_merged"
    done
    exec {find_output_fd}<&-

    if ! wait "$find_process_id"; then
        printf 'ERROR\trepository discovery failed\n' >&2
        ((FAILURES += 1))
    fi
}

printSummary() {
    printf 'SUMMARY\trepositories=%d\tcompacted=%d\tverified=%d\tmerged_candidates=%d\tdeleted=%d\tfailures=%d\n' \
        "$REPOSITORIES" "$COMPACTED" "$VERIFIED" "$CANDIDATES" "$DELETED" "$FAILURES"
}

##==================================================================================================
##	ARGUMENT PARSING

parseArguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --report) REPORT_ONLY=true ;;
            --verify) VERIFY=true ;;
            --delete-merged) DELETE_MERGED=true ;;
            --base)
                shift
                [[ $# -gt 0 ]] || die 'Missing branch after --base'
                BASE_BRANCH=$1
                ;;
            --help)
                printUsage
                exit 0
                ;;
            -*) die "Unknown option: $1" ;;
            *)
                [[ $DIRECTORY_SET == false ]] || die 'Only one directory allowed'
                ROOT_DIRECTORY=$1
                DIRECTORY_SET=true
                ;;
        esac
        shift
    done

    [[ $DELETE_MERGED == false || -n $BASE_BRANCH ]] || die '--delete-merged requires --base'
    [[ $REPORT_ONLY == false || $DELETE_MERGED == false ]] || die '--report cannot delete branches'
}

##==================================================================================================
##	MAIN

main() {
    parseArguments "$@"
    ROOT_DIRECTORY=$(resolveRootDirectory "$ROOT_DIRECTORY")
    processRepositoryTree "$ROOT_DIRECTORY" "$REPORT_ONLY" "$VERIFY" "$BASE_BRANCH" "$DELETE_MERGED"
    printSummary
    ((FAILURES == 0))
}

##==================================================================================================
##	SCRIPT ENTRY POINT

main "$@"
