#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	GLOBALS
##==================================================================================================

declare -a PATHS=()
declare -a PATH_SOURCES=()
declare -a MARKDOWN_PATHS=()
INSPECT_UNSTAGED=true
INSPECT_STAGED=true
INSPECT_UNTRACKED=true

##==================================================================================================
##	UTILITIES
##==================================================================================================

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

requireCommand() {
    local command_name=$1
    command -v "$command_name" >/dev/null 2>&1 || die "Missing command: $command_name. Install it, then rerun this script."
}

printUsage() {
    cat <<'USAGE'
Usage: git-change-inspect [--staged|--worktree]

Inspect Git changes from repository root: status, numstats, paths, file types,
and Markdown lint. Default scope includes unstaged, staged, and untracked files.

Options:
  --staged    Inspect staged changes only.
  --worktree  Inspect unstaged and untracked changes only.
  -h, --help  Show this message.
USAGE
}

isExistingPath() {
    local path=$1

    [[ -e $path || -L $path ]]
}

isMarkdownPath() {
    local path=$1

    [[ $path == *.md || $path == *.markdown ]]
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================

addPath() {
    local source=$1
    local path=$2
    local index

    for index in "${!PATHS[@]}"; do
        if [[ ${PATHS[$index]} == "$path" ]]; then
            PATH_SOURCES[index]+=" $source"
            return
        fi
    done

    PATHS+=("$path")
    PATH_SOURCES+=("$source")
}

collectPaths() {
    local source=$1
    shift
    local path

    while IFS= read -r -d '' path; do
        addPath "$source" "$path"
    done < <("$@")
}

printNumstats() {
    local source=$1
    shift

    printf 'NUMSTAT\t%s\n' "$source"
    "$@"
}

printStatus() {
    if [[ $INSPECT_STAGED == true && $INSPECT_UNSTAGED == false && $INSPECT_UNTRACKED == false ]]; then
        printf 'STATUS\tstaged\n'
        git diff --cached --name-status
        return
    fi

    if [[ $INSPECT_UNSTAGED == true && $INSPECT_STAGED == false && $INSPECT_UNTRACKED == true ]]; then
        printf 'STATUS\tworktree\n'
        git diff --name-status
        git ls-files --others --exclude-standard | while IFS= read -r path; do
            printf '??\t%s\n' "$path"
        done
        return
    fi

    printf 'STATUS\tall\n'
    git status --short --untracked-files=all
}

collectChangePaths() {
    if [[ $INSPECT_UNSTAGED == true ]]; then
        collectPaths unstaged git diff --name-only -z
    fi
    if [[ $INSPECT_STAGED == true ]]; then
        collectPaths staged git diff --cached --name-only -z
    fi
    if [[ $INSPECT_UNTRACKED == true ]]; then
        collectPaths untracked git ls-files --others --exclude-standard -z
    fi
}

printChangeSummary() {
    if [[ $INSPECT_UNSTAGED == true ]]; then
        printNumstats unstaged git diff --numstat
    fi
    if [[ $INSPECT_STAGED == true ]]; then
        printNumstats staged git diff --cached --numstat
    fi
}

reportPathsAndTypes() {
    local index
    local path

    for index in "${!PATHS[@]}"; do
        path=${PATHS[$index]}
        printf 'PATH\t%s\t%q\n' "${PATH_SOURCES[$index]}" "$path"
        if isExistingPath "$path"; then
            printf 'FILE\t%q\t' "$path"
            file --brief -- "$path"
            if isMarkdownPath "$path"; then
                MARKDOWN_PATHS+=("$path")
            fi
        else
            printf 'FILE\t%q\tdeleted\n' "$path"
        fi
    done
}

lintMarkdown() {
    ((${#MARKDOWN_PATHS[@]})) || return 0

    requireCommand markdownlint-cli2
    printf 'MARKDOWNLINT\t%s file(s); failure blocks commit\n' "${#MARKDOWN_PATHS[@]}"
    markdownlint-cli2 -- "${MARKDOWN_PATHS[@]}"
}

##==================================================================================================
##	ARGUMENT PARSING
##==================================================================================================

parseArguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --staged)
            INSPECT_UNSTAGED=false
            INSPECT_STAGED=true
            INSPECT_UNTRACKED=false
            ;;
        --worktree)
            INSPECT_UNSTAGED=true
            INSPECT_STAGED=false
            INSPECT_UNTRACKED=true
            ;;
        -h | --help)
            printUsage
            exit 0
            ;;
        *)
            printUsage
            die "Unknown argument: $1"
            ;;
        esac
        shift
    done
}

##==================================================================================================
##	MAIN
##==================================================================================================

main() {
    requireCommand file
    requireCommand git
    cd "$(git rev-parse --show-toplevel)" || die 'Not inside a Git repository'

    printStatus
    printChangeSummary
    collectChangePaths
    reportPathsAndTypes
    lintMarkdown
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================

parseArguments "$@"
main
