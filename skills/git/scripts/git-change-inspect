#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	GLOBALS
##==================================================================================================

declare -a PATHS=()
declare -A STATE_BY_PATH=()
declare -A ADD_BY_PATH=()
declare -A DEL_BY_PATH=()
INSPECT_UNSTAGED=true
INSPECT_STAGED=true
INSPECT_UNTRACKED=true
SHOW_TYPES=false
SHOW_CONTEXT=false

##==================================================================================================
##	UTILITIES
##==================================================================================================

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

requireCommand() {
    local command_name=$1
    command -v "$command_name" >/dev/null 2>&1 || die "Missing command: $command_name. Install it, then rerun this script."
}

printUsage() {
    cat <<'USAGE'
Usage: git-change-inspect [--staged|--worktree] [--types] [--context]

Inspect Git changes from repository root. One line per changed path:
  CHANGE\t<state>\t<+adds>\t<-dels>\t<path>[\t<file-type>]
state is one of: staged, unstaged, untracked, both. Deleted paths show
0/0 counts with state marker; no separate deletion line. Path field is
the raw literal path (tab-separated field, not shell-quoted); a path
containing a literal tab or newline fails closed with a nonzero exit
rather than emitting an ambiguous line.

Options:
  --staged    Inspect staged changes only.
  --worktree  Inspect unstaged and untracked changes only.
  --types     Append `file --brief` type column (opt-in; shells out per path).
  --context   Prepend one REPO line: toplevel, branch, short HEAD.
  -h, --help  Show this message.

Default scope: unstaged + staged + untracked. Silent beyond the change
lines and (with --context) one REPO line. Does not lint or gate; see
git-lint-changed for Markdown lint.
USAGE
}

isExistingPath() {
    local path=$1

    [[ -e $path || -L $path ]]
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================

recordState() {
    local source=$1
    local path=$2

    if [[ $path == *$'\t'* || $path == *$'\n'* ]]; then
        die "Path contains a literal tab or newline, unsupported by this line format: $path"
    fi

    if [[ -n ${STATE_BY_PATH[$path]+set} && ${STATE_BY_PATH[$path]} != "$source" ]]; then
        STATE_BY_PATH[$path]='both'
    else
        STATE_BY_PATH[$path]=$source
    fi

    if [[ -z ${ADD_BY_PATH[$path]+set} ]]; then
        PATHS+=("$path")
        ADD_BY_PATH[$path]=0
        DEL_BY_PATH[$path]=0
    fi
}

collectPaths() {
    local source=$1
    shift
    local path

    while IFS= read -r -d '' path; do
        recordState "$source" "$path"
    done < <("$@")
}

applyNumstat() {
    local source=$1
    shift
    local adds dels path

    while IFS=$'\t' read -r -d '' adds dels path; do
        [[ -n $path ]] || continue
        recordState "$source" "$path"
        [[ $adds == '-' ]] && adds=0
        [[ $dels == '-' ]] && dels=0
        ADD_BY_PATH[$path]=$((${ADD_BY_PATH[$path]:-0} + adds))
        DEL_BY_PATH[$path]=$((${DEL_BY_PATH[$path]:-0} + dels))
    done < <("$@" -z)
}

collectChanges() {
    if [[ $INSPECT_UNSTAGED == true ]]; then
        applyNumstat unstaged git diff --no-renames --numstat
    fi
    if [[ $INSPECT_STAGED == true ]]; then
        applyNumstat staged git diff --cached --no-renames --numstat
    fi
    if [[ $INSPECT_UNTRACKED == true ]]; then
        collectPaths untracked git ls-files --others --exclude-standard -z
    fi
}

printRepoContext() {
    [[ $SHOW_CONTEXT == true ]] || return 0

    local toplevel branch head_sha
    toplevel=$(git rev-parse --show-toplevel)
    branch=$(git symbolic-ref --quiet --short HEAD || printf 'HEAD-detached')
    head_sha=$(git rev-parse --short HEAD 2>/dev/null || printf 'no-commits')
    printf 'REPO\t%s\tBRANCH\t%s\tHEAD\t%s\n' "$toplevel" "$branch" "$head_sha"
}

printChanges() {
    local path state adds dels type_column

    for path in "${PATHS[@]}"; do
        state=${STATE_BY_PATH[$path]}
        adds=${ADD_BY_PATH[$path]:-0}
        dels=${DEL_BY_PATH[$path]:-0}
        type_column=''
        if [[ $SHOW_TYPES == true ]]; then
            requireCommand file
            if isExistingPath "$path"; then
                type_column=$'\t'$(file --brief -- "$path")
            else
                type_column=$'\t'deleted
            fi
        fi
        printf 'CHANGE\t%s\t%s\t%s\t%s%s\n' "$state" "$adds" "$dels" "$path" "$type_column"
    done
}

##==================================================================================================
##	ARGUMENT PARSING
##==================================================================================================

parseArguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --staged)
            INSPECT_UNSTAGED=false
            INSPECT_STAGED=true
            INSPECT_UNTRACKED=false
            ;;
        --worktree)
            INSPECT_UNSTAGED=true
            INSPECT_STAGED=false
            INSPECT_UNTRACKED=true
            ;;
        --types)
            SHOW_TYPES=true
            ;;
        --context)
            SHOW_CONTEXT=true
            ;;
        -h | --help)
            printUsage
            exit 0
            ;;
        *)
            printUsage
            die "Unknown argument: $1"
            ;;
        esac
        shift
    done
}

##==================================================================================================
##	MAIN
##==================================================================================================

main() {
    requireCommand git
    cd "$(git rev-parse --show-toplevel)" || die 'Not inside a Git repository'

    printRepoContext
    collectChanges
    printChanges
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================

parseArguments "$@"
main
