#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	DEPENDENCY CHECKS
##==================================================================================================

requireCommand() {
    local command_name=$1
    command -v "$command_name" >/dev/null 2>&1 || {
        printf 'Missing command: %s. Install it, then rerun this script.\n' "$command_name" >&2
        exit 1
    }
}

requireCommand git
requireCommand gitleaks
requireCommand trufflehog
requireCommand detect-secrets-hook
requireCommand xargs

##==================================================================================================
##	UTILITIES
##==================================================================================================

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================

ensureStagedChanges() {
    local diff_status

    if git diff --cached --quiet; then
        die 'No staged changes to scan'
    else
        diff_status=$?
        ((diff_status == 1)) || die 'Cannot inspect staged changes'
    fi
}

runGitleaks() {
    gitleaks git --pre-commit --staged --redact=100
}

runTrufflehog() {
    git diff --cached --binary --no-ext-diff -- . |
        trufflehog stdin --fail --fail-on-scan-errors
}

runDetectSecrets() {
    local -a detect_secrets_args=()

    if [[ -f .secrets.baseline ]]; then
        detect_secrets_args=(--baseline .secrets.baseline)
    fi

    git diff --cached --name-only -z |
        xargs -0 detect-secrets-hook "${detect_secrets_args[@]}"
}

runSecretScans() {
    local scan_failures=0

    if ! runGitleaks; then
        scan_failures=1
    fi
    if ! runTrufflehog; then
        scan_failures=1
    fi
    if ! runDetectSecrets; then
        scan_failures=1
    fi
    ((scan_failures == 0)) || die 'secret scanner failure or finding'
}

##==================================================================================================
##	MAIN
##==================================================================================================

main() {
    cd "$(git rev-parse --show-toplevel)" || die 'Not inside a Git repository'
    ensureStagedChanges
    runSecretScans
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================

(( $# == 0 )) || die 'No arguments accepted'
main
