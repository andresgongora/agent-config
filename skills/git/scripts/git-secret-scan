#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

##==================================================================================================
##	GLOBALS
##==================================================================================================

declare -r DEFAULT_SCANNER='gitleaks'
SCANNER=$DEFAULT_SCANNER # mutable, set by argument parsing
IDENTITY_SCAN=true
ACCEPT_IDENTITY_EXPOSURE=false

##==================================================================================================
##	UTILITIES
##==================================================================================================

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

requireCommand() {
    local command_name=$1
    command -v "$command_name" >/dev/null 2>&1 || die "Missing command: $command_name. Install it, then rerun this script."
}

getGitConfig() {
    local key=$1

    git config --get "$key" || true
}

escapeRegex() {
    local value=$1

    printf '%s' "$value" | sed 's/[][\\.^$*+?{}|()/]/\\&/g'
}

buildFuzzyNamePattern() {
    local compact_name=$1
    local character
    local pattern=''
    local index

    for ((index = 0; index < ${#compact_name}; index += 1)); do
        character=${compact_name:index:1}
        ((index > 0)) && pattern+='[^[:alnum:]]*'
        pattern+="$character"
    done
    printf '%s' "$pattern"
}

##==================================================================================================
##	CORE FUNCTIONS
##==================================================================================================

ensureStagedChanges() {
    if git diff --cached --quiet; then
        die 'No staged changes to scan'
    fi
}

runGitleaks() {
    local output

    requireCommand gitleaks
    if ! output=$(gitleaks git --pre-commit --staged --redact=100 2>&1); then
        printf '%s\n' "$output" >&2
        return 1
    fi
}

runTrufflehog() {
    local output

    requireCommand trufflehog
    if ! output=$(git diff --cached --binary --no-ext-diff -- . |
        trufflehog stdin --fail --fail-on-scan-errors 2>&1); then
        printf '%s\n' "$output" >&2
        return 1
    fi
}

runDetectSecrets() {
    local output
    local -a detect_secrets_args=()

    requireCommand detect-secrets-hook
    requireCommand xargs

    if [[ -f .secrets.baseline ]]; then
        detect_secrets_args=(--baseline .secrets.baseline)
    fi

    if ! output=$(git diff --cached --name-only -z |
        xargs -0 detect-secrets-hook "${detect_secrets_args[@]}" 2>&1); then
        printf '%s\n' "$output" >&2
        return 1
    fi
}

findStagedMatches() {
    local match_status=0

    ## rg prints matches itself; exit 1 means no match, any other failure is fatal.
    git diff --cached --text --unified=0 --no-ext-diff -- . | rg "$@" || match_status=$?
    case $match_status in
    0) return 0 ;;
    1) return 1 ;;
    *) die "Identity scan failed (rg exit $match_status)" ;;
    esac
}

scanIdentityLeak() {
    local username
    local full_name
    local compact_name
    local username_pattern
    local home_pattern
    local full_name_pattern

    requireCommand git
    requireCommand id
    requireCommand rg
    requireCommand sed
    requireCommand tr
    username=$(id -un) || die 'Cannot determine local username'
    full_name=$(getGitConfig user.name)
    username_pattern=$(escapeRegex "$username")
    home_pattern=$(escapeRegex "$HOME")

    if findStagedMatches --pcre2 --line-number --color=never "^\\+[^+].*(?:${home_pattern}|/home/${username_pattern})(?:/|\\b)"; then
        die 'Identity path found in staged text; remove it before committing'
    fi

    if findStagedMatches --pcre2 --ignore-case --line-number --color=never "^\\+[^+].*\\b${username_pattern}\\b"; then
        die 'Username found in staged text; remove it before committing'
    fi

    [[ -n $full_name ]] || return 0
    compact_name=$(printf '%s' "$full_name" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')
    [[ ${#compact_name} -ge 4 ]] || return 0
    full_name_pattern=$(buildFuzzyNamePattern "$compact_name")

    if findStagedMatches --pcre2 --ignore-case --line-number --color=never "^\\+[^+].*${full_name_pattern}"; then
        if [[ $ACCEPT_IDENTITY_EXPOSURE == true ]]; then
            printf '%s\n' 'WARNING accepted: full-name-like text found in staged content.' >&2
        else
            die 'WARNING: full-name-like text found. Obtain explicit user acceptance, then rerun with --accept-identity-exposure.'
        fi
    fi
}

runSelectedScanner() {
    local scanner=$1
    local scan_failures=0

    case "$scanner" in
    gitleaks) runGitleaks || scan_failures=1 ;;
    trufflehog) runTrufflehog || scan_failures=1 ;;
    detect-secrets) runDetectSecrets || scan_failures=1 ;;
        all)
        runGitleaks || scan_failures=1
        runTrufflehog || scan_failures=1
        runDetectSecrets || scan_failures=1
        ;;
    *) die "Unknown scanner: $scanner (expected gitleaks, trufflehog, detect-secrets, or all)" ;;
    esac

    ((scan_failures == 0)) || die 'secret scanner failure or finding'
}

##==================================================================================================
##	ARGUMENT PARSING
##==================================================================================================

printUsage() {
    cat <<'USAGE'
Usage: git-secret-scan [--scanner gitleaks|trufflehog|detect-secrets|all] [--skip-identity-scan] [--accept-identity-exposure]

Scans staged changes for secrets and identity leaks. Default scanner: gitleaks.
Paths and usernames block commit. Full-name-like text warns; require explicit user
approval before continuing: rerun with `--accept-identity-exposure`. `--skip-identity-scan`
also requires explicit user approval.
Run from repository root before each commit.
USAGE
}

parseArguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --scanner)
            [[ $# -ge 2 ]] || die '--scanner requires a value'
            SCANNER=$2
            shift 2
            ;;
        --skip-identity-scan)
            IDENTITY_SCAN=false
            shift
            ;;
        --accept-identity-exposure)
            ACCEPT_IDENTITY_EXPOSURE=true
            shift
            ;;
        -h | --help)
            printUsage
            exit 0
            ;;
        *)
            printUsage
            die "Unknown argument: $1"
            ;;
        esac
    done
}

##==================================================================================================
##	MAIN
##==================================================================================================

main() {
    cd "$(git rev-parse --show-toplevel)" || die 'Not inside a Git repository'
    ensureStagedChanges
    [[ $IDENTITY_SCAN == true ]] && scanIdentityLeak
    runSelectedScanner "$SCANNER"
    printf 'OK: no secrets or identity leaks found (scanner: %s)\n' "$SCANNER"
}

##==================================================================================================
##	SCRIPT ENTRY POINT
##==================================================================================================

parseArguments "$@"
main
