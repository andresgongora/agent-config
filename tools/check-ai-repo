#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

fail=0
warn=0

say() { printf '%s\n' "$*"; }
bad() { say "FAIL: $*"; fail=1; }
note() { say "WARN: $*"; warn=1; }

for skill in skills/*; do
  [ -d "$skill" ] || continue
  name="$(basename "$skill")"
  skill_md="$skill/SKILL.md"
  readme="$skill/README.md"

  if [ ! -f "$skill_md" ]; then
    bad "$name missing SKILL.md"
    continue
  fi

  grep -q '^name:' "$skill_md" || bad "$name SKILL.md missing frontmatter name"
  grep -q '^description:' "$skill_md" || bad "$name SKILL.md missing frontmatter description"

  case "$name" in
    caveman|caveman-commit|caveman-compress|caveman-help|caveman-review|caveman-stats) ;;
    *) [ -f "$readme" ] || note "$name missing README.md" ;;
  esac
done

for doc in .agent/**/*.md; do
  [ -f "$doc" ] || continue
  grep -q '^---$' "$doc" || bad "$doc missing frontmatter fence"
  grep -q '^title:' "$doc" || bad "$doc missing title"
  grep -q '^summary:' "$doc" || bad "$doc missing summary"
done

if grep -R -n --exclude='check-ai-repo' '`web-fetch`' AGENTS.md README.md agents skills .agent >/dev/null; then
  bad "stale active web-fetch reference remains"
fi

if [ -f .agent/frontier.md ]; then
  lines="$(wc -l < .agent/frontier.md | tr -d ' ')"
  if [ "$lines" -gt 70 ]; then
    note ".agent/frontier.md is $lines lines; review for signal/noise and prune if it is growing by accumulation rather than need"
  fi
fi

for path in skills/*/SKILL.md; do
  [ -f "$path" ] || continue
  grep -q '^---$' "$path" || bad "$path missing frontmatter fence"
done

if [ "$fail" -ne 0 ]; then
  exit 1
fi

if [ "$warn" -ne 0 ]; then
  exit 2
fi

say "OK: ai repo checks passed"
